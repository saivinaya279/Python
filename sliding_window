def max_sum_fixed_window(arr, k):
    n = len(arr)
    if n < k:
        return None   

    window_sum = sum(arr[:k])     
    max_sum = window_sum

    for right in range(k, n):
        window_sum += arr[right]        
        window_sum -= arr[right - k]    
        max_sum = max(max_sum, window_sum)

    return max_sum


arr = [2, 1, 5, 1, 3, 2]
print(max_sum_fixed_window(arr, 3))   